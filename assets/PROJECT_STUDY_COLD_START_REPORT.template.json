{
  "schema_version": "1.1",
  "mode": "fresh-model-no-chat",
  "fresh_session": true,
  "input_scope": "document-only",
  "document_hash": "<sha256>",
  "model": "<host and model identifier>",
  "steps": {
    "<Step>": {
      "objective": "<what the Step solves>",
      "runtime_position": "<RUN/NODE position>",
      "call_chain": "<ordered caller to callee chain>",
