      "io_shape_state": "<input/output/Shape/state explanation>",
      "important_qa": "<important Q and answer>",
      "exercise_answer": "<answer derived from the handbook>",
      "evidence_boundary": "<confirmed/inferred/not-run boundary>",
      "lookup_path": "<quick index -> CHAPTER anchor or Q/symbol lookup path>",
      "retrieval_result": "pass",
      "explanation_result": "pass",
      "application_result": "pass",
      "result": "pass"
    }
  },
  "overall_status": "pass"
}
